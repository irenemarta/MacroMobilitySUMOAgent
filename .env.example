#  Configuration of the database connection - to copy to .env file with personal credentials
DB_CONNECTION_STRING=server:driver://username:psw@host
DTSUMO_BASE_PATH="path/to/root"
DTSUMO_BASE_PATH = "/path/to/dtSumo"
DTSUMO_SENSOR_DATA = "path/to/sensors/data/flows.csv"
DTSUMO_SEED=1 # default seed for simulation run
DTSUMO_RUN=sumo-x.xx # used sumo version, e.g. sumo-1.28